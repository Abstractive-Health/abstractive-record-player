{
  "name": "abstractive-record-player",
  "version": "1.0.0",
  "description": "Record Player: an open-source SMART on FHIR sample app by Abstractive Health. Every chart has a soundtrack.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Abstractive Health",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abstractive-Health/abstractive-record-player.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build:catalog": "node scripts/build-catalog.mjs",
    "verify:catalog": "node scripts/build-catalog.mjs --verify-only",
    "demo": "node e2e/demo.mjs"
  },
  "dependencies": {
    "fhirclient": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
