# Build-time settings (public: they ship in the browser bundle). Override in .env.local or CI.

# SMART client id registered in Abstractive's SMART_CLIENTS_JSON.
VITE_SMART_CLIENT_ID=abstractive-record-player

# Abstractive Health FHIR servers (the launch `iss`). There the app reads only the AI summary.
VITE_ABSTRACTIVE_ISS=https://test-api.abstractive.ai/fhir/r4,https://api.abstractive.ai/fhir/r4

# Other SMART servers the app may be launched from, such as the SMART App Launcher sandbox used
# by the SMART App Gallery. A trailing /* also accepts any path below it (the launcher puts
# launch settings in the path). They have no Abstractive AI summary, so there the app also reads
# the patient's age and problem list (Patient, Condition) to pick a song.
VITE_SANDBOX_ISS=https://launch.smarthealthit.org/v/r4/*

# Any other FHIR server is refused.
